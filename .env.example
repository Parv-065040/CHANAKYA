# ===== CHANAKYA configuration. Copy to .env and fill in. NEVER commit .env. =====

# --- LLM (Groq). Leave GROQ_API_KEY empty to run in offline deterministic mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Embeddings: hashing (offline, default) | sentence-transformers (local BGE-M3, needs torch) | hf-inference (hosted)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
HF_API_TOKEN=
HF_EMBED_URL=

# --- Storage: local (default, files under CHANAKYA_DATA_DIR) | supabase
STORAGE_BACKEND=local
CHANAKYA_DATA_DIR=./data/store
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=chanakya-docs

# --- Access control: none (demo) | tokens
AUTH_MODE=none
ADMIN_TOKEN=
# JSON: token -> list of departments, or "*" for all. Example:
# USER_TOKENS={"finance-token": ["finance"], "exec-token": "*"}
USER_TOKENS={}

# --- Behaviour
SEED_DEMO_DATA=true
MIN_RELEVANCE=0.15
MIN_COVERAGE=0.6
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=25
CORS_ORIGIN=*
PORT=8000
